# Copy to .env for local development. Values match infra/docker-compose.yml.
DATABASE_URL=postgresql://eccs:eccs@localhost:5432/eccs
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:8333
S3_REGION=ap-south-1
S3_BUCKET=eccs-local
S3_ACCESS_KEY=eccs
S3_SECRET_KEY=eccs-secret

API_PORT=4000
WEB_URL=http://localhost:3000

# Sample mode: no real SMS or payments. Every one-time code is this value.
DEV_FIXED_OTP=123456

# Key for storing restaurant PINs. Development value only: production needs
# its own long random secret, and changing it invalidates every PIN.
PIN_SECRET=dev-only-pin-secret-change-me-in-production

# Reads licence details off uploaded documents. "ai" (the default) uses the AI and
# falls back to the free reader on this server whenever AI is off or fails; "ocr"
# uses only the free reader; "off" reads nothing.
LICENCE_READER=ai

# AI (the Claude API). The key comes from Anthropic's console (console.anthropic.com,
# "API keys"). It stays on this server: never put it in the apps or anywhere else.
# Without it every AI feature is simply off and the app works as before.
# ANTHROPIC_API_KEY=
# The main switch: "off" turns every AI feature off.
AI_FEATURES=on
# The most to spend on AI in one day (India time), in US dollars: across everything,
# and for any one outlet. Over either, AI steps aside until the next day.
AI_DAILY_LIMIT_USD=2
AI_OUTLET_DAILY_LIMIT_USD=0.25
# Features to switch off one by one, separated by commas. The names are:
# licence-reader, translate-support, translate-content, explain-score,
# monitoring-digest, inspection-summary, photo-check, photo-standard
# (photo-standard off: the camera nudge judges from the item's wording alone)
AI_DISABLED_FEATURES=
# Tests only: AI_ENGINE=fake gives fixed answers without calling Anthropic.
# AI_ENGINE=real

# How restaurants reach ECCS from the app. Sample numbers: replace with the real ones.
SUPPORT_PHONE=+919000000000
SUPPORT_WHATSAPP=919000000000
SUPPORT_HOURS=Every day, 8 am to 10 pm

# Push notifications to phones through Expo's push service. "off" sends nothing;
# "on" also sends each new notification to the person's registered phones.
# Needs the installed app (not Expo Go) and this computer on the internet. See docs/APK_BUILD.md.
PUSH_NOTIFICATIONS=off
# Only if "enhanced security for push notifications" is switched on at expo.dev:
# EXPO_ACCESS_TOKEN=

# Key for signing the short-lived links that display photos. Development value only.
FILE_URL_SECRET=dev-only-file-url-secret-change-me-in-production

# Face attendance: the key the face templates of restaurant staff are encrypted with
# in the database. Development value only: production needs its own long random
# secret (at least 32 characters), and the API refuses to start there without one.
# Changing or losing it makes every stored template unreadable, so everyone would
# have to enrol their face again. Keep the production key somewhere safe.
FACE_TEMPLATE_KEY=dev-only-face-template-key-change-me-in-production
# Which engine recognises faces: "onnx" (the models on this server, the default) or "off".
# The model files are fetched once with: pnpm --filter @eccs/api face:models
# FACE_ENGINE=onnx

# Terms and privacy: restaurant users (Owner, Manager, Head Chef) must agree to the
# Terms of Service and Privacy Policy before using the app. "on" (the default) makes
# the server refuse their other requests until they have agreed; "off" stops the
# refusing, though the app still asks them. Leave it on. The automated tests switch
# it off for their own run.
LEGAL_GATE=on

# The activity log behind the console's Logs page: what happens in the restaurant app,
# the Supervisor's app, the console, the AI and the server's timed work. Never PINs,
# codes, tokens, typed text, checklist problems or staff details. "on" (the default)
# records; "off" records nothing new. The automated tests switch it off for their run.
ACTIVITY_LOG=on
# How many days log rows are kept before a daily job deletes them. The Privacy Policy
# draft says a year: change both together.
ACTIVITY_LOG_DAYS=365

# The customer QR page: the address diners reach it at, without "/k/<token>".
# Every printed QR code holds this address, so set it to the real, lasting web
# address of the hosted console before printing any. While it is a local address
# the app says "this link only works inside the office network for now".
PUBLIC_PAGE_BASE_URL=http://localhost:3000
