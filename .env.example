# Copy to .env for local development. Values match infra/docker-compose.yml.
DATABASE_URL=postgresql://eccs:eccs@localhost:5432/eccs
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=eccs-local
S3_ACCESS_KEY=eccs
S3_SECRET_KEY=eccs-secret

API_PORT=4000
WEB_URL=http://localhost:3000

# Sample mode: no real SMS or payments. Any phone number logs in with this OTP.
DEV_FIXED_OTP=123456
