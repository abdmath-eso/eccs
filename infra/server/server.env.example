# ECCS server settings (Stage H, 19 Oct 2026). On the server, copy this file to /opt/eccs/.env,
# fill it in, and never put the filled-in copy in git. Docker Compose reads it by itself; the API
# reads every line (apps/api/src/config/env.ts). After a change: docker compose up -d
# Write values without quotes and without spaces around "=". Use letters and digits in passwords.

# -- Addresses --
# The API's address (the apps and the console call https://<this>/v1).
API_HOST=api.example.in
# The console's address.
CONSOLE_HOST=console.example.in
# Where printed QR codes and quote links point; must differ from CONSOLE_HOST.
PUBLIC_HOST=example.in
# Let's Encrypt writes here if a certificate cannot be renewed.
ACME_EMAIL=you@example.in
# The console's full address: the only web page the API lets call it (CORS).
WEB_URL=https://console.example.in
# What every QR code holds before "/k/<token>": https:// and PUBLIC_HOST. Never change it once codes are printed.
PUBLIC_PAGE_BASE_URL=https://example.in

# -- Test server or live server --
# Test server only: "testing" also starts its own database (the postgres service in compose.yml). Live: leave empty.
COMPOSE_PROFILES=
# Test server only: "on" allows the fixed login code below with NODE_ENV=production. Live: off.
SAMPLE_SERVER=off
# Test server only (with SAMPLE_SERVER=on): every login code is this 6-digit number and no SMS is sent. Remove the # to use it; live: keep the #.
# DEV_FIXED_OTP=123456

# -- Database --
# Live: the Lightsail managed database's address, with ?sslmode=require. Test server: postgresql://eccs:<POSTGRES_PASSWORD>@postgres:5432/eccs
DATABASE_URL=postgresql://USER:PASSWORD@ENDPOINT:5432/eccs?sslmode=require
# Test server only: the password of its own database (letters and digits); repeat it in DATABASE_URL.
POSTGRES_PASSWORD=

# -- Secrets: filled in by `node infra/scripts/new-secrets.mjs <this file>`; keep a copy in the password manager --
# Key for storing restaurant PINs; changing it stops every PIN working.
PIN_SECRET=
# Key for signing the short-lived links that show photos.
FILE_URL_SECRET=
# Key that locks every enrolled face; if it is lost or changed, everyone enrols their face again.
FACE_TEMPLATE_KEY=

# -- Files (Amazon S3, Mumbai) --
# The bucket's name.
S3_BUCKET=
# The bucket's region (Mumbai).
S3_REGION=ap-south-1
# The access key of the IAM user that can reach only this bucket (infra/RUNBOOK.md).
S3_ACCESS_KEY=
# That access key's secret.
S3_SECRET_KEY=
# Leave empty for Amazon S3; set only for a stand-in such as SeaweedFS (e.g. http://host:8333).
S3_ENDPOINT=

# -- AI (the Claude API) --
# The key from console.anthropic.com; without it every AI feature is off by itself.
ANTHROPIC_API_KEY=
# The main switch: "off" turns every AI feature off, whatever the console says.
AI_FEATURES=on
# AI features to switch off one by one, separated by commas (names in .env.example).
AI_DISABLED_FEATURES=
# Reading licence details: "ai" (falls back to the free reader), "ocr" (free reader only) or "off".
LICENCE_READER=ai
# Starting daily AI limits in US dollars, for everything and per outlet, until set in the console (AI usage > Settings).
AI_DAILY_LIMIT_USD=2
AI_OUTLET_DAILY_LIMIT_USD=0.25

# -- Notifications --
# Push notifications to phones through Expo: "on" for the live server.
PUSH_NOTIFICATIONS=on
# Only if "enhanced security for push notifications" is switched on at expo.dev.
EXPO_ACCESS_TOKEN=

# -- How restaurants reach ECCS (shown in the app; sample numbers until the real ones exist) --
# The support phone number, with +91.
SUPPORT_PHONE=+919000000000
# The WhatsApp number, digits only, with 91.
SUPPORT_WHATSAPP=919000000000
# When support answers.
SUPPORT_HOURS=Every day, 8 am to 10 pm

# -- Rules --
# How many days a login lasts.
SESSION_TTL_DAYS=30
# Restaurant users must agree to the Terms and Privacy Policy before using the app: keep "on".
LEGAL_GATE=on
# The activity log behind the console's Logs page: keep "on".
ACTIVITY_LOG=on
# Days log rows are kept; the Privacy Policy draft promises a year.
ACTIVITY_LOG_DAYS=365
# Face recognition on this server: "onnx" (the models in the image) or "off" (assisted clock-in only).
FACE_ENGINE=onnx
