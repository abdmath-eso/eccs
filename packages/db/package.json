{
  "name": "@eccs/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "library:import": "node scripts/import-checklist-library.mjs",
    "library:load": "tsx prisma/load-library.ts",
    "visits:load": "tsx prisma/load-sample-visits.ts",
    "sops:load": "tsx prisma/load-sops.ts",
    "soplibrary:import": "node scripts/import-sop-library.mjs",
    "soplibrary:load": "tsx prisma/load-sop-library.ts",
    "reset": "prisma migrate reset --force",
    "studio": "prisma studio",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "dotenv": "^18.0.5",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
