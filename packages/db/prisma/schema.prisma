// ECCS data model. Specification: docs/PROPOSAL.md section 4.
//
// Conventions
// - Ids are UUIDs so phones can create records offline and upload them later.
// - Money is stored as whole paise (Int) to avoid rounding errors.
// - Text shown to restaurant staff is Json of the form { "en": "...", "te": "...", "hi": "..." }.
// - Fields ending in "ById" without a relation are audit pointers to User.id.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Tenancy and people ─────────────────────────

enum Role {
  SUPER_ADMIN
  OPS_MANAGER
  SUPERVISOR
  OWNER
  MANAGER
  HEAD_CHEF
}

/// The languages the apps can be used in. Keep in step with LANGUAGES in @eccs/shared
/// and the dictionaries in packages/i18n.
enum Language {
  EN
  TE
  HI
  TA /// Tamil
  KN /// Kannada
  ML /// Malayalam
  MR /// Marathi
  BN /// Bengali
  GU /// Gujarati
  PA /// Punjabi
  OR /// Odia
  UR /// Urdu
}

/// A restaurant brand (the client).
model Organization {
  id             String   @id @default(uuid())
  name           String
  legalName      String?
  gstin          String?
  billingAddress String?
  stateCode      String? /// GST state code, decides CGST+SGST versus IGST
  contactPhone   String?
  contactEmail   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  outlets       Outlet[]
  memberships   Membership[]
  invoices      Invoice[]
  linkedDevices LinkedDevice[]
}

model Outlet {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  /// The restaurant code typed once on each new phone to link it, e.g. "SPICE-7K2M9Q".
  code           String   @unique
  address        String
  city           String   @default("Hyderabad")
  pincode        String?
  latitude       Float?
  longitude      Float?
  fssaiNumber    String?
  kitchenType    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization             Organization           @relation(fields: [organizationId], references: [id])
  linkedDevices            LinkedDevice[]
  memberships              Membership[]
  outletChecklists         OutletChecklist[]
  customChecklistItems     ChecklistItem[]
  customChecklistTemplates ChecklistTemplate[]
  checklistRuns            ChecklistRun[]
  subscriptions            Subscription[]
  bookings                 Booking[]
  schedules                ServiceSchedule[]
  jobs                     Job[]
  certificates             Certificate[]
  inspections              Inspection[]
  licences                 Licence[]
  sopTemplates             SopTemplate[]
  documents                Document[]
  issues                   Issue[]
  scoreSnapshots           HygieneScoreSnapshot[]
  invoices                 Invoice[]
  staffMembers             StaffMember[]
  attendancePunches        AttendancePunch[]
  attendanceSettings       AttendanceSettings?
  foodItems                FoodItem[]
  foodLabels               FoodLabel[]
  attachments              Attachment[]
  publicProfile            PublicProfile?

  @@index([organizationId])
}

model User {
  id                String   @id @default(uuid())
  /// ECCS users and restaurant owners have a phone (for the one-time code).
  /// Other restaurant staff log in with a PIN only and need no phone.
  phone             String?  @unique
  name              String
  email             String?  @unique
  language          Language @default(EN)
  /// Restaurant users only. The PIN is unique within its organisation and is
  /// stored as a keyed hash (see pinLookup in packages/db/src/pin.ts).
  pinOrganizationId String?
  pinLookup         String?
  /// The Attachment (kind PROFILE) holding this person's profile photo, if they have set one.
  photoId           String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  memberships    Membership[]
  deviceTokens   DeviceToken[]
  notifications  Notification[]
  submittedRuns  ChecklistRun[]
  supervisedJobs Job[]
  inspections    Inspection[]
  raisedIssues   Issue[]        @relation("IssueRaisedBy")
  assignedIssues Issue[]        @relation("IssueAssignee")
  issueComments  IssueComment[]
  sessions       Session[]

  @@unique([pinOrganizationId, pinLookup])
}

/// A user's role and where it applies. ECCS roles have no organization;
/// OWNER has an organization; MANAGER and HEAD_CHEF have an outlet too.
model Membership {
  id             String   @id @default(uuid())
  userId         String
  role           Role
  organizationId String?
  outletId       String?
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])
  outlet       Outlet?       @relation(fields: [outletId], references: [id])

  @@unique([userId, role, organizationId, outletId])
  @@index([organizationId])
  @@index([outletId])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String /// "android" or "ios"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────── SOPs and checklists ─────────────────────────

enum ChecklistKind {
  DAILY /// filled by the restaurant
  SERVICE /// filled by the ECCS supervisor during a visit
  INSPECTION /// scored ECCS audit
}

enum ChecklistItemType {
  YES_NO
  NUMBER
  TEXT
  PHOTO
}

enum ChecklistFrequency {
  DAILY
  PER_SHIFT
  WEEKLY
}

enum ChecklistRunStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  MISSED
}

model SopTemplate {
  id          String   @id @default(uuid())
  code        String   @unique
  title       Json
  body        Json /// the SOP text per language, Markdown
  category    String
  version     Int      @default(1)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Set when a restaurant wrote this SOP for one of its own outlets.
  /// Empty for ECCS's standard SOPs, which every restaurant reads.
  outletId    String?
  createdById String?
  /// The library SOP this was copied from, if it was. Lets the app show it as already added.
  libraryItemId String?

  outlet             Outlet?             @relation(fields: [outletId], references: [id])
  libraryItem        SopLibraryItem?     @relation(fields: [libraryItemId], references: [id])
  checklistTemplates ChecklistTemplate[]

  @@index([outletId])
}

/// A ready-made SOP that a restaurant can find by searching or browsing and
/// copy into its own SOPs. Loaded from the founder's workbook; English only.
model SopLibraryItem {
  id        String   @id @default(uuid())
  /// Stable identifier from the workbook, e.g. "SOP-0042" or "CSP-0007".
  code      String   @unique
  /// "OPERATION" for how the restaurant is run, "RECIPE" for dishes, sauces and cooking methods.
  kind      String
  name      String
  /// One of the app's SOP categories (SOP_CATEGORIES in @eccs/shared).
  category  String
  /// The workbook's own grouping inside the category: a module such as
  /// "Cleaning & Sanitation", or for recipes a cuisine such as "Indian - South".
  section   String
  role      String?
  area      String?
  frequency String?
  purpose   String
  /// One step per line.
  steps     String
  /// What to take particular care over, where the workbook says something specific.
  controls  String?
  /// The same SOP in other languages, where it has been translated:
  /// { "te": { "name", "purpose", "steps" (one per line), "controls" }, "hi": { ... } }.
  /// The columns above are always the English.
  translations Json?
  /// Everything searchable about the item, in lower case, in every language it has.
  searchText String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sops SopTemplate[]

  @@index([isActive, category, section])
}

model ChecklistTemplate {
  id            String        @id @default(uuid())
  sopTemplateId String?
  kind          ChecklistKind
  title         Json
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  /// Set when a restaurant created this checklist for one of its own outlets
  /// (for example "Mid-day checklist"). Empty for ECCS's basic checklists.
  outletId      String?
  createdById   String?

  sopTemplate      SopTemplate?      @relation(fields: [sopTemplateId], references: [id])
  outlet           Outlet?           @relation(fields: [outletId], references: [id])
  items            ChecklistItem[]
  outletChecklists OutletChecklist[]
  serviceTypes     ServiceType[]
  inspections      Inspection[]
}

model ChecklistItem {
  id            String            @id @default(uuid())
  templateId    String
  position      Int
  section       String?
  label         Json
  type          ChecklistItemType @default(YES_NO)
  photoRequired Boolean           @default(false)
  weight        Int               @default(1) /// used for inspection scoring
  minValue      Float? /// for NUMBER items, e.g. fridge temperature range
  maxValue      Float?
  /// Set when a restaurant added this item for one of its own outlets.
  /// Empty for the basic items ECCS provides to everyone.
  outletId      String?
  createdById   String?
  /// Set when the item was picked from the suggestion library rather than typed.
  libraryItemId String?
  isActive      Boolean           @default(true)

  template            ChecklistTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  outlet              Outlet?               @relation(fields: [outletId], references: [id])
  libraryItem         ChecklistLibraryItem? @relation(fields: [libraryItemId], references: [id])
  responses           ChecklistResponse[]
  jobTaskResponses    JobTaskResponse[]
  inspectionResponses InspectionResponse[]

  @@index([templateId, position])
}

/// A ready-made check that an Owner or Manager can find by typing and add
/// to their checklist. Loaded from docs/Restaurant_Master_Checklist_Library.xlsx
/// plus ECCS's own additions; see packages/db/prisma/library.ts.
model ChecklistLibraryItem {
  id            String   @id @default(uuid())
  /// Stable identifier from the source, e.g. "CHK-0003-07" or "ECCS-GAS-01".
  code          String   @unique
  /// "sheet" for the founder's master library, "eccs" for ECCS's additions.
  source        String
  checklistName String
  category      String
  area          String?
  frequency     String?
  role          String?
  /// "HIGH" or "MEDIUM". High-priority checks are listed first.
  priority      String   @default("MEDIUM")
  text          Json
  /// Everything searchable about the item, in lower case.
  searchText    String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items ChecklistItem[]

  @@index([isActive])
}

/// A checklist template switched on for an outlet, with its schedule.
model OutletChecklist {
  id         String             @id @default(uuid())
  outletId   String
  templateId String
  frequency  ChecklistFrequency @default(DAILY)
  shifts     String[] /// e.g. ["opening", "closing"] when PER_SHIFT
  dueTime    String? /// "HH:mm" local time, drives reminders
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())

  outlet   Outlet            @relation(fields: [outletId], references: [id])
  template ChecklistTemplate @relation(fields: [templateId], references: [id])
  runs     ChecklistRun[]

  @@index([outletId])
}

model ChecklistRun {
  id                String             @id @default(uuid())
  outletChecklistId String
  outletId          String
  date              DateTime           @db.Date
  shift             String             @default("")
  status            ChecklistRunStatus @default(PENDING)
  submittedById     String?
  submittedAt       DateTime?
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime           @default(now())

  outletChecklist OutletChecklist     @relation(fields: [outletChecklistId], references: [id])
  outlet          Outlet              @relation(fields: [outletId], references: [id])
  submittedBy     User?               @relation(fields: [submittedById], references: [id])
  responses       ChecklistResponse[]

  @@unique([outletChecklistId, date, shift])
  @@index([outletId, date])
}

model ChecklistResponse {
  id           String   @id @default(uuid())
  runId        String
  itemId       String
  valueBool    Boolean?
  valueNumber  Float?
  valueText    String?
  passed       Boolean?
  note         String?
  /// Who gave this answer. For photo items this is also who took the photo.
  answeredById String?
  capturedAt   DateTime /// time on the phone when answered, may precede upload

  run         ChecklistRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  item        ChecklistItem @relation(fields: [itemId], references: [id])
  attachments Attachment[]

  @@unique([runId, itemId])
}

// ───────────────────────── Files ─────────────────────────

enum AttachmentKind {
  PROOF
  BEFORE
  AFTER
  DOCUMENT
  SIGNATURE
  REPORT
  PROFILE /// a person's own profile photo; belongs to no outlet
  PUNCH /// the photo taken when someone clocks in or out; for the Owner and Manager only, deleted after 35 days
}

/// A photo or file in object storage. At most one of the owner links is set.
model Attachment {
  id           String         @id @default(uuid())
  outletId     String?
  kind         AttachmentKind
  storageKey   String         @unique
  mimeType     String
  sizeBytes    Int?
  capturedAt   DateTime?
  uploadedById String?
  createdAt    DateTime       @default(now())

  // Photo integrity (9 Oct 2026): what is known about a proof photo, so a doubtful one can be
  // marked for ECCS. `createdAt` above is the server's own receipt time, the reference for time.
  /// The time the phone said the photo was taken, exactly as sent (capturedAt may have been corrected).
  phoneCapturedAt  DateTime?
  /// Server receipt time minus the phone's capture time, in seconds. Large and positive for a photo sent later from the outbox; negative when the phone's clock is ahead.
  captureGapSeconds Int?
  /// "CAMERA" when the app's camera took it, "FILE" when it was picked from files (the browser preview). Empty when the sender did not say.
  source           String?
  /// SHA-256 of the file, to recognise the identical file used again.
  contentHash      String?
  /// A fingerprint of what the picture looks like (144 hex characters: its brightness in 72 cells), to recognise a near-copy. Empty when it could not be worked out.
  perceptualHash   String?
  /// Where the phone was when the photo was taken, if the person allowed it.
  latitude         Float?
  longitude        Float?
  /// How sure the phone was of that place, as a radius in metres.
  locationAccuracy Float?
  /// True when the phone itself reported the place as coming from a "mock location" app (Android).
  locationMocked   Boolean?
  /// Metres between that place and the outlet's, when both are known.
  distanceMetres   Int?
  /// The reasons this photo is doubtful: a list of PhotoFlagDto (packages/shared/src/photo-integrity.ts). Empty list or null when none.
  integrityFlags   Json?
  /// True when integrityFlags is not empty; kept as its own column so the monitoring board can count quickly.
  doubtful         Boolean   @default(false)
  /// When the checks were run: the moment the photo became evidence for something.
  integrityCheckedAt DateTime?

  checklistResponseId String?
  jobId               String?
  issueId             String?
  inspectionFindingId String?

  outlet            Outlet?            @relation(fields: [outletId], references: [id])
  checklistResponse ChecklistResponse? @relation(fields: [checklistResponseId], references: [id])
  job               Job?               @relation(fields: [jobId], references: [id])
  issue             Issue?             @relation(fields: [issueId], references: [id])
  inspectionFinding InspectionFinding? @relation(fields: [inspectionFindingId], references: [id])
  documents         Document[]
  publicPhotos      PublicPhoto[]
  signOffs          SignOff[]

  @@index([outletId])
  @@index([checklistResponseId])
  @@index([jobId])
  @@index([issueId])
  @@index([outletId, contentHash])
  @@index([outletId, doubtful])
}

// ───────────────────────── Services, booking, scheduling ─────────────────────────

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum JobStatus {
  SCHEDULED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  APPROVED
  CANCELLED
}

/// Deep clean, pest control, chimney and hood, safety inspection.
model ServiceType {
  id                   String   @id @default(uuid())
  code                 String   @unique
  name                 Json
  sacCode              String /// GST code: an SAC for a service, an HSN for goods (the chemicals refill)
  gstRatePercent       Float    @default(18)
  /// The heading the app lists it under: CLEANING, PEST, TESTING, COMPLIANCE or SUPPLIES
  /// (SERVICE_CATEGORIES in packages/shared).
  category             String   @default("CLEANING")
  /// True when an outside partner (a lab, a clinic, a training partner, an audit agency)
  /// delivers part of it. The visit then records which partner, and their result document.
  partnerDelivered     Boolean  @default(false)
  checklistTemplateId  String?
  issuesCertificate    Boolean  @default(false)
  certificateValidDays Int?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())

  checklistTemplate ChecklistTemplate?   @relation(fields: [checklistTemplateId], references: [id])
  catalogItems      ServiceCatalogItem[]
  planLines         PlanLine[]
  schedules         ServiceSchedule[]
  jobs              Job[]
  certificates      Certificate[]
}

/// A priced, bookable one-time service.
model ServiceCatalogItem {
  id              String   @id @default(uuid())
  serviceTypeId   String
  name            Json
  description     Json?
  pricePaise      Int
  durationMinutes Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])
  bookings    Booking[]
}

/// A subscription bundle.
model Plan {
  id           String       @id @default(uuid())
  code         String       @unique
  name         Json
  description  Json?
  pricePaise   Int /// per billing cycle, before GST
  billingCycle BillingCycle @default(MONTHLY)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  lines         PlanLine[]
  subscriptions Subscription[]
}

/// One included service and how often it happens, e.g. pest control every 15 days.
model PlanLine {
  id            String @id @default(uuid())
  planId        String
  serviceTypeId String
  intervalDays  Int

  plan        Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])

  @@unique([planId, serviceTypeId])
}

model Subscription {
  id              String             @id @default(uuid())
  outletId        String
  planId          String
  status          SubscriptionStatus @default(ACTIVE)
  startDate       DateTime           @db.Date
  endDate         DateTime?          @db.Date
  nextBillingDate DateTime?          @db.Date
  /// The price agreed for this outlet, per billing cycle before GST. Copied from the plan when the
  /// subscription starts, so a later change to the plan's price does not silently change what a client pays.
  pricePaise         Int?
  billingCycle       BillingCycle?
  /// The cycle already invoiced (or being invoiced).
  currentPeriodStart DateTime?     @db.Date
  currentPeriodEnd   DateTime?     @db.Date
  /// Asked to end: it stays active until currentPeriodEnd and is then cancelled, not renewed.
  cancelAtPeriodEnd  Boolean       @default(false)
  /// Asked to change plan: the new plan takes over at the next cycle.
  pendingPlanId      String?
  pausedAt           DateTime?
  cancelledAt        DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  outlet    Outlet            @relation(fields: [outletId], references: [id])
  plan      Plan              @relation(fields: [planId], references: [id])
  schedules ServiceSchedule[]
  invoices  Invoice[]

  @@index([outletId])
}

/// A one-time service request from a restaurant.
model Booking {
  id            String        @id @default(uuid())
  outletId      String
  catalogItemId String
  preferredDate DateTime      @db.Date
  preferredSlot String? /// e.g. "morning", "after closing"
  notes         String?
  status        BookingStatus @default(REQUESTED)
  requestedById String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  outlet      Outlet             @relation(fields: [outletId], references: [id])
  catalogItem ServiceCatalogItem @relation(fields: [catalogItemId], references: [id])
  job         Job?
  invoices    Invoice[]

  @@index([outletId])
}

/// A recurring service for an outlet. The worker creates Jobs from this.
model ServiceSchedule {
  id             String   @id @default(uuid())
  outletId       String
  serviceTypeId  String
  subscriptionId String?
  intervalDays   Int
  nextDueDate    DateTime @db.Date
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  outlet       Outlet        @relation(fields: [outletId], references: [id])
  serviceType  ServiceType   @relation(fields: [serviceTypeId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  jobs         Job[]

  @@index([outletId])
  @@index([nextDueDate])
}

/// One service visit. Recorded on site by the ECCS supervisor.
model Job {
  id               String    @id @default(uuid())
  outletId         String
  serviceTypeId    String
  scheduleId       String?
  bookingId        String?   @unique
  scheduledDate    DateTime  @db.Date
  /// For a visit created from a recurring schedule: the date it was due on. It stays the
  /// same when ECCS moves the visit, so the same due date is never filled twice.
  plannedFor       DateTime? @db.Date
  scheduledSlot    String?
  status           JobStatus @default(SCHEDULED)
  supervisorId     String?
  technicianNames  String[] /// technicians have no login; names are recorded for the report
  checkInAt        DateTime?
  checkInLatitude  Float?
  checkInLongitude Float?
  checkInDistanceM Int? /// metres from the outlet's saved location
  completedAt      DateTime?
  /// Set when an ECCS admin has checked the finished visit's report and released it to
  /// the restaurant. Until then the restaurant cannot read the report or sign it off.
  reviewedAt       DateTime?
  reviewedById     String?
  /// What ECCS asked the Supervisor to correct when sending the report back. Cleared on approval.
  reviewNote       String?
  approvedById     String?
  approvedAt       DateTime?
  notes            String?
  /// The outside partner that did the partner's share of the work (the lab, clinic,
  /// training partner or audit agency), as typed by ECCS. Empty for ECCS's own work.
  partnerName      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  outlet         Outlet             @relation(fields: [outletId], references: [id])
  serviceType    ServiceType        @relation(fields: [serviceTypeId], references: [id])
  schedule       ServiceSchedule?   @relation(fields: [scheduleId], references: [id])
  booking        Booking?           @relation(fields: [bookingId], references: [id])
  supervisor     User?              @relation(fields: [supervisorId], references: [id])
  taskResponses  JobTaskResponse[]
  chemicalUsages JobChemicalUsage[]
  attachments    Attachment[]
  signOff        SignOff?
  serviceReport  ServiceReport?
  certificates   Certificate[]
  issues         Issue[]

  @@unique([scheduleId, plannedFor])
  @@index([outletId, scheduledDate])
  @@index([supervisorId, scheduledDate])
  @@index([status])
}

model JobTaskResponse {
  id          String   @id @default(uuid())
  jobId       String
  itemId      String
  valueBool   Boolean?
  valueNumber Float?
  valueText   String?
  note        String?
  capturedAt  DateTime

  job  Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  item ChecklistItem @relation(fields: [itemId], references: [id])

  @@unique([jobId, itemId])
}

model Chemical {
  id               String  @id @default(uuid())
  name             String  @unique
  activeIngredient String?
  unit             String /// "ml", "g", "L"
  safetyNotes      String?
  isActive         Boolean @default(true)

  usages JobChemicalUsage[]
}

model JobChemicalUsage {
  id          String  @id @default(uuid())
  jobId       String
  chemicalId  String
  quantity    Float
  dilution    String?
  areaApplied String?

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  chemical Chemical @relation(fields: [chemicalId], references: [id])

  @@index([jobId])
}

/// The restaurant's sign-off at the end of a visit.
model SignOff {
  id                    String   @id @default(uuid())
  jobId                 String   @unique
  signerName            String
  signerRole            String?
  signatureAttachmentId String?
  signedAt              DateTime
  /// How the restaurant rated the visit when signing it off, 1 (poor) to 5 (excellent).
  rating                Int?
  /// What they wrote about the service, if anything.
  comment               String?

  job       Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  signature Attachment? @relation(fields: [signatureAttachmentId], references: [id])
}

model ServiceReport {
  id          String   @id @default(uuid())
  jobId       String   @unique
  number      String   @unique
  pdfKey      String?
  generatedAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id])
}

model Certificate {
  id            String   @id @default(uuid())
  outletId      String
  serviceTypeId String
  jobId         String?
  number        String   @unique
  validFrom     DateTime @db.Date
  validUntil    DateTime @db.Date
  pdfKey        String?
  createdAt     DateTime @default(now())

  outlet      Outlet      @relation(fields: [outletId], references: [id])
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])
  job         Job?        @relation(fields: [jobId], references: [id])

  @@index([outletId])
}

// ───────────────────────── Inspections ─────────────────────────

enum InspectionStatus {
  DRAFT /// planned or being filled in by the Supervisor
  SUBMITTED /// finished and scored; waiting for ECCS to approve
  APPROVED /// final; the restaurant can read it
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// How one check of an inspection was answered.
enum InspectionAnswer {
  COMPLIANT
  NON_COMPLIANT
  NOT_APPLICABLE /// left out of the score altogether
}

/// A scored ECCS audit of an outlet, modelled on FSSAI Schedule 4.
model Inspection {
  id            String           @id @default(uuid())
  outletId      String
  templateId    String
  /// Who carries it out: the Supervisor it was given to, or the person who started it.
  supervisorId  String
  status        InspectionStatus @default(DRAFT)
  conductedAt   DateTime
  /// The day it is meant to happen (India date).
  plannedDate   DateTime?        @db.Date
  /// Set when the first check is answered. A DRAFT without it has not been started.
  startedAt     DateTime?
  /// When the Supervisor finished and the score was worked out.
  completedAt   DateTime?
  overallScore  Float? /// 0 to 100
  sectionScores Json?
  /// "A_PLUS", "A", "B" or "NON_COMPLIANT" (INSPECTION_GRADES in @eccs/shared).
  grade         String?
  reportNumber  String?          @unique
  pdfKey        String?
  approvedById  String?
  approvedAt    DateTime?
  /// What ECCS asked the Supervisor to correct when sending the report back.
  reviewNote    String?
  createdById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  outlet     Outlet               @relation(fields: [outletId], references: [id])
  template   ChecklistTemplate    @relation(fields: [templateId], references: [id])
  supervisor User                 @relation(fields: [supervisorId], references: [id])
  responses  InspectionResponse[]
  findings   InspectionFinding[]

  @@index([outletId, conductedAt])
  @@index([supervisorId, status])
}

model InspectionResponse {
  id           String           @id @default(uuid())
  inspectionId String
  itemId       String
  answer       InspectionAnswer
  passed       Boolean?
  /// Marks earned: the check's weight if compliant, 0 if not, empty if not applicable.
  score        Float?
  note         String?
  answeredAt   DateTime         @default(now())

  inspection Inspection         @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  item       ChecklistItem      @relation(fields: [itemId], references: [id])
  /// The non-compliance recorded for this check, when the answer is NON_COMPLIANT.
  finding    InspectionFinding?

  @@unique([inspectionId, itemId])
}

/// A non-conformity found during an inspection.
model InspectionFinding {
  id               String    @id @default(uuid())
  inspectionId     String
  /// The answer this non-compliance belongs to; its photos are Attachment rows pointing here.
  responseId       String?   @unique
  /// Empty until the Supervisor has chosen one; required before the inspection can be finished.
  severity         Severity?
  description      String
  correctiveAction String?
  dueDate          DateTime? @db.Date
  resolvedAt       DateTime?

  inspection  Inspection          @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  response    InspectionResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  issues      Issue[]

  @@index([inspectionId])
}

// ───────────────────────── Compliance, issues, score ─────────────────────────

enum LicenceType {
  FSSAI
  FIRE_NOC
  TRADE_LICENCE
  PEST_CONTROL
  OTHER
}

enum IssueCategory {
  PEST_SIGHTING
  CHIMNEY
  EQUIPMENT
  HYGIENE
  SUPPORT
  OTHER
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Licence {
  id         String      @id @default(uuid())
  outletId   String
  type       LicenceType
  name       String?
  number     String?
  issuedOn   DateTime?   @db.Date
  expiresOn  DateTime    @db.Date
  documentId String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  outlet   Outlet    @relation(fields: [outletId], references: [id])
  document Document? @relation(fields: [documentId], references: [id])

  @@index([outletId])
  @@index([expiresOn])
}

/// The document vault.
model Document {
  id           String   @id @default(uuid())
  outletId     String
  category     String /// "licence", "service-report", "certificate", "invoice", "other"
  title        String
  attachmentId String
  uploadedById String?
  createdAt    DateTime @default(now())

  outlet     Outlet     @relation(fields: [outletId], references: [id])
  attachment Attachment @relation(fields: [attachmentId], references: [id])
  licences   Licence[]

  @@index([outletId, category])
}

/// Problems and requests raised by a restaurant or by ECCS. Category SUPPORT is a support ticket.
model Issue {
  id                  String        @id @default(uuid())
  /// Running number shown to people as "ECCS-0042".
  reference           Int           @unique @default(autoincrement())
  outletId            String
  category            IssueCategory
  severity            Severity      @default(MEDIUM)
  title               String
  description         String?
  status              IssueStatus   @default(OPEN)
  raisedById          String
  assigneeId          String?
  jobId               String?
  inspectionFindingId String?
  resolvedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  outlet            Outlet             @relation(fields: [outletId], references: [id])
  raisedBy          User               @relation("IssueRaisedBy", fields: [raisedById], references: [id])
  assignee          User?              @relation("IssueAssignee", fields: [assigneeId], references: [id])
  job               Job?               @relation(fields: [jobId], references: [id])
  inspectionFinding InspectionFinding? @relation(fields: [inspectionFindingId], references: [id])
  comments          IssueComment[]
  attachments       Attachment[]

  @@index([outletId, status])
}

model IssueComment {
  id        String   @id @default(uuid())
  issueId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@index([issueId])
}

model HygieneScoreSnapshot {
  id        String   @id @default(uuid())
  outletId  String
  date      DateTime @db.Date
  score     Float /// 0 to 100
  breakdown Json /// points per component, see PROPOSAL.md "Hygiene score"

  outlet Outlet @relation(fields: [outletId], references: [id])

  @@unique([outletId, date])
}

// ───────────────────────── Billing ─────────────────────────

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String
  outletId       String?
  subscriptionId String?
  bookingId      String?
  number         String        @unique /// sequential per financial year
  issueDate      DateTime      @db.Date
  dueDate        DateTime      @db.Date
  status         InvoiceStatus @default(DRAFT)
  subtotalPaise  Int
  cgstPaise      Int           @default(0)
  sgstPaise      Int           @default(0)
  igstPaise      Int           @default(0)
  totalPaise     Int
  paidPaise      Int           @default(0)
  /// For a subscription invoice: the cycle it covers.
  periodStart    DateTime?     @db.Date
  periodEnd      DateTime?     @db.Date
  /// The buyer exactly as printed on the invoice (name, legal name, GSTIN, address, state code),
  /// so a later change to the client's details never alters an invoice already issued.
  billTo         Json?
  /// GST state code of the place of supply.
  placeOfSupply  String?
  notes          String?
  voidedAt       DateTime?
  voidReason     String?
  pdfKey         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  outlet       Outlet?       @relation(fields: [outletId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  booking      Booking?      @relation(fields: [bookingId], references: [id])
  lines        InvoiceLine[]
  payments     Payment[]

  @@index([organizationId, status])
  @@index([outletId])
}

model InvoiceLine {
  id             String @id @default(uuid())
  invoiceId      String
  description    String
  sacCode        String
  quantity       Float  @default(1)
  unitPricePaise Int
  gstRatePercent Float
  amountPaise    Int /// taxable value of the line

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id                String        @id @default(uuid())
  invoiceId         String
  amountPaise       Int
  method            String /// "upi", "card", "netbanking", "cash", "bank-transfer"
  status            PaymentStatus @default(PENDING)
  reference         String?
  razorpayOrderId   String?
  razorpayPaymentId String?       @unique
  /// Which way the money came: "sample" (the pretend online payment) or "manual" (ECCS recorded cash, a transfer or a UPI reference).
  gateway           String?
  failureReason     String?
  recordedById      String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

// ───────────────────────── Restaurant staff management ─────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  WEEKLY_OFF
}

/// How a restaurant employee is paid: a fixed amount a month, or by the day worked.
enum StaffPayType {
  MONTHLY
  DAILY
}

/// Money handed to an employee: an advance against a month's pay, or a payment of it.
enum StaffPayEntryKind {
  ADVANCE
  PAYMENT
}

/// A restaurant employee. Not a User: most staff never log in.
model StaffMember {
  id                 String       @id @default(uuid())
  outletId           String
  name               String
  jobTitle           String?
  phone              String?
  payType            StaffPayType @default(MONTHLY)
  monthlySalaryPaise Int          @default(0) /// used when payType is MONTHLY
  dailyWagePaise     Int          @default(0) /// used when payType is DAILY
  overtimeRatePaise  Int? /// per hour
  weeklyOffDay       Int? /// 0 Sunday to 6 Saturday; empty when the person has no fixed day off
  joinedOn           DateTime?    @db.Date
  leftOn             DateTime?    @db.Date /// the last day they worked; set when they leave
  userId             String? /// their app login, where the same person has one (not a relation, like markedById)
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  outlet     Outlet             @relation(fields: [outletId], references: [id])
  attendance AttendanceRecord[]
  salaries   SalaryRecord[]
  payEntries StaffPayEntry[]
  faceTemplates FaceTemplate[]
  faceConsents  FaceConsent[]
  punches       AttendancePunch[]

  @@index([outletId])
}

/// Where a day's status came from: worked out from the punches, or entered by the Owner.
enum AttendanceSource {
  PUNCHES
  OWNER
}

/// One person's FINAL status for one attendance day; the salary arithmetic reads this table.
/// Face attendance (11 Oct 2026): a row with source PUNCHES is worked out from the day's
/// AttendancePunch rows and rewritten whenever they change. A row with source OWNER was
/// entered by the Owner (leave, weekly off, or a correction, always with a reason in `note`)
/// and is never overwritten by that working-out. Rows from before face attendance were all
/// marked by hand, so they are OWNER.
model AttendanceRecord {
  id            String           @id @default(uuid())
  staffMemberId String
  date          DateTime         @db.Date
  status        AttendanceStatus
  source        AttendanceSource @default(OWNER)
  /// Minutes between each clock-in and its clock-out, added up. Empty when not known (a punch is missing) or the Owner set the day.
  workedMinutes Int?
  /// What the Owner should look at: DayFlag values from packages/shared/src/attendance-rules.ts (NO_CLOCK_OUT, SHORT_DAY, ...).
  flags         String[]         @default([])
  overtimeHours Float            @default(0)
  /// For an Owner entry: the reason, which is required.
  note          String?
  /// For an Owner entry: who made it. `updatedAt` is when.
  markedById    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@unique([staffMemberId, date])
}

/// One enrolled view of a person's face, as a template: the list of numbers the recognition
/// model gives for it. No photo is kept. `vector` is encrypted (AES-256-GCM with the key in
/// FACE_TEMPLATE_KEY): 12 bytes of nonce, 16 bytes of check tag, then the numbers.
/// Deleted when the person withdraws consent or leaves.
model FaceTemplate {
  id            String   @id @default(uuid())
  staffMemberId String
  vector        Bytes
  /// The model the template came from; templates of different models cannot be compared.
  modelId       String
  /// How sharp the enrolment photo was, on the model's own scale.
  quality       Float
  createdAt     DateTime @default(now())

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([staffMemberId])
}

/// The employee's own consent to face enrolment, one row per enrolment, kept as history.
/// `endedAt` is set when that consent stopped applying: withdrawn, the person left, or they
/// enrolled again (which starts a new row). The row outlives the templates: it is the proof
/// that consent was given and that the templates were deleted.
model FaceConsent {
  id            String    @id @default(uuid())
  staffMemberId String
  /// Which wording was shown (FACE_CONSENT_VERSION in packages/shared/src/attendance.ts).
  version       String
  /// The language it was shown in.
  language      Language
  /// When the employee tapped "I agree", from the phone.
  acceptedAt    DateTime
  acceptedBy    String    @default("EMPLOYEE")
  /// The Owner login the enrolment was done under.
  recordedById  String?
  createdAt     DateTime  @default(now())
  endedAt       DateTime?
  /// WITHDRAWN, LEFT or REENROLLED.
  endedReason   String?
  endedById     String?

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([staffMemberId, createdAt])
}

enum PunchKind {
  IN
  OUT
}

/// FACE: recognised by the camera. ASSISTED: the Owner or Manager vouched with their PIN.
/// CORRECTION: added afterwards by the Owner, with a reason.
enum PunchMethod {
  FACE
  ASSISTED
  CORRECTION
}

enum PunchFlag {
  UNSURE_MATCH
  ASSISTED
  NO_CLOCK_OUT
  POSSIBLE_SPOOF
  OFFLINE
}

/// One clock-in or clock-out. Never deleted: a wrong one is voided, with who, when and why.
model AttendancePunch {
  id            String      @id @default(uuid())
  outletId      String
  staffMemberId String
  /// The SERVER's time, never the phone's.
  at            DateTime    @db.Timestamptz(3)
  kind          PunchKind
  method        PunchMethod
  /// How alike the face was to the person's template (cosine similarity), and to the next most alike person at the outlet.
  score         Float?
  secondScore   Float?
  /// The linked phone it came from (LinkedDevice.id).
  deviceId      String?
  /// The photo taken at the punch (Attachment.id, kind PUNCH). Emptied when the photo is deleted after 35 days.
  photoId       String?
  flag          PunchFlag?
  /// For a correction: the Owner's reason.
  note          String?
  /// The Owner or Manager login behind an assisted punch or a correction. Empty for a face punch.
  createdById   String?
  createdAt     DateTime    @default(now())
  /// When the Owner looked at a flagged punch and let it stand.
  reviewedAt    DateTime?
  reviewedById  String?
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  outlet      Outlet      @relation(fields: [outletId], references: [id])

  @@index([staffMemberId, at])
  @@index([outletId, at])
  @@index([outletId, flag])
}

/// An outlet's own figures for what counts as a full day and a half day. No row means the
/// standard figures (8 hours and 4 hours). Changed by the Owner only.
model AttendanceSettings {
  outletId       String   @id
  fullDayMinutes Int      @default(480)
  halfDayMinutes Int      @default(240)
  updatedById    String?
  updatedAt      DateTime @default(now()) @updatedAt

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
}

/// One month's pay for one employee. A record, not a payroll calculation.
/// payType and basePaise hold the rate of pay that applies to this month (the monthly
/// salary or the daily wage), so a later raise does not change an earlier month.
/// daysWorked, advancesPaise, netPaise, paidPaise and paidOn are copies of what the
/// app worked out when the record was last saved; the app always works them out
/// again from attendance and the pay entries when it shows a month.
model SalaryRecord {
  id                   String    @id @default(uuid())
  staffMemberId        String
  month                DateTime  @db.Date /// first day of the month
  payType              StaffPayType @default(MONTHLY)
  basePaise            Int
  daysWorked           Float
  overtimeHours        Float     @default(0)
  overtimePaise        Int       @default(0)
  bonusPaise           Int       @default(0)
  advancesPaise        Int       @default(0)
  deductionsPaise      Int       @default(0)
  netPaise             Int
  paidPaise            Int       @default(0)
  paidOn               DateTime? @db.Date
  note                 String?
  dueOverridePaise     Int? /// the Owner's own figure for the month's pay, replacing the one worked out from attendance
  carriedOverridePaise Int? /// the Owner's own figure for what was carried in from earlier months (negative: overpaid)
  updatedById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@unique([staffMemberId, month])
}

/// An advance given to an employee, or a payment of their pay, each on its own date.
model StaffPayEntry {
  id            String            @id @default(uuid())
  staffMemberId String
  month         DateTime          @db.Date /// first day of the month whose pay it counts against
  kind          StaffPayEntryKind
  date          DateTime          @db.Date /// the day the money was handed over
  amountPaise   Int
  note          String?
  createdById   String?
  createdAt     DateTime          @default(now())

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([staffMemberId, month])
}

// ───────────────────────── Food labels ─────────────────────────

enum StorageType {
  AMBIENT
  CHILLED
  FROZEN
}

model FoodItem {
  id             String      @id @default(uuid())
  outletId       String
  name           Json
  shelfLifeHours Int
  /// Where it is kept. Empty when nobody has said: a label needs only a name and how long it keeps.
  storage        StorageType?
  /// Allergen codes from ALLERGENS in packages/shared/src/food-labels.ts.
  allergens      String[]    @default([])
  note           String?
  /// Which entry of the starter list it was added from, if any.
  starterKey     String?
  /// False once retired: kept for the labels already made, not offered for new ones.
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt

  outlet Outlet      @relation(fields: [outletId], references: [id])
  labels FoodLabel[]

  @@index([outletId])
}

/// A label stays LIVE (the food is in the kitchen) until someone marks it used up or thrown away.
enum FoodLabelStatus {
  LIVE
  USED
  DISCARDED
}

enum FoodDiscardReason {
  EXPIRED
  SPOILED
  OTHER
}

/// One label made for a container of food. The item's name, storage and allergens are
/// copied onto it, so a later change to the item never alters what an old label said.
model FoodLabel {
  id             String             @id @default(uuid())
  outletId       String
  foodItemId     String
  itemName       String             @default("")
  storage        StorageType?
  allergens      String[]           @default([])
  preparedAt     DateTime
  expiresAt      DateTime
  /// The login that prepared it, when that is the person who made the label.
  preparedById   String?
  preparedByName String             @default("")
  quantityNote   String?
  copies         Int                @default(1)
  status         FoodLabelStatus    @default(LIVE)
  discardReason  FoodDiscardReason?
  closeNote      String?
  closedAt       DateTime?
  closedById     String?
  /// Set when a Manager or Owner put use-by later than the shelf life allows.
  overrideReason String?
  overrideById   String?
  createdById    String?
  /// An id chosen on the phone for a label made without signal, so sending it twice makes one label.
  clientId       String?            @unique
  printedAt      DateTime?
  createdAt      DateTime           @default(now())

  outlet   Outlet   @relation(fields: [outletId], references: [id])
  foodItem FoodItem @relation(fields: [foodItemId], references: [id])

  @@index([outletId, expiresAt])
  @@index([outletId, status, expiresAt])
}

// ───────────────────────── Customer QR page ─────────────────────────

enum PublicPhotoStatus {
  PROPOSED
  APPROVED
  REJECTED
}

/// The public page a diner sees after scanning the outlet's QR code.
model PublicProfile {
  id        String   @id @default(uuid())
  outletId  String   @unique
  token     String   @unique /// random, goes in the QR URL
  /// The restaurant's own switch (the Owner's). Off until the Owner turns it on.
  isEnabled Boolean  @default(false)
  /// When the link was last replaced ("make a new link"); codes printed before then stop working.
  tokenChangedAt  DateTime?
  /// Set while ECCS has taken the page down (a client leaving, a complaint). The
  /// restaurant's switch cannot bring the page back while this is set.
  takenDownAt     DateTime?
  takenDownById   String?
  takenDownReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet Outlet        @relation(fields: [outletId], references: [id])
  photos PublicPhoto[]
}

model PublicPhoto {
  id           String            @id @default(uuid())
  profileId    String
  attachmentId String
  caption      Json?
  status       PublicPhotoStatus @default(PROPOSED)
  position     Int               @default(0)
  proposedById String?
  /// The ECCS admin who approved or rejected it, and when.
  approvedById String?
  decidedAt    DateTime?
  /// What the photo shows, from a fixed list (PUBLIC_PHOTO_CAPTIONS in packages/shared): "GRILL", "HOOD" and so on.
  captionCode  String?
  /// Why ECCS rejected it, for the Supervisor who proposed it.
  rejectReason String?
  /// Set when the restaurant's Owner (or ECCS) took an approved photo off the page.
  removedAt    DateTime?
  removedById  String?
  createdAt    DateTime          @default(now())

  profile    PublicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  attachment Attachment    @relation(fields: [attachmentId], references: [id])

  @@index([profileId, status])
}

// ───────────────────────── Cross-cutting ─────────────────────────

model Notification {
  id        String    @id @default(uuid())
  userId    String
  channel   String /// "app" (the list inside the app), later "push", "sms", "email"
  /// What it is about, e.g. "REPORT_READY". The apps word it in the reader's language
  /// from this and `data`; `title` and `body` hold the English wording as a fallback.
  type      String?
  title     String
  body      String
  /// The values for the wording (names, dates) and where tapping it leads.
  data      Json?
  /// Set for reminders, so the same reminder is not sent to the same person twice.
  dedupeKey String?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// A one-time login code sent to a phone. Only a hash of the code is stored.
model OtpChallenge {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

/// A logged-in device. Only a hash of the token is stored.
model Session {
  id             String    @id @default(uuid())
  userId         String
  tokenHash      String    @unique
  deviceName     String?
  linkedDeviceId String?
  expiresAt      DateTime
  revokedAt      DateTime?
  lastUsedAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedDevice LinkedDevice? @relation(fields: [linkedDeviceId], references: [id])

  @@index([userId])
}

/// A phone that has been linked to a restaurant, by typing the outlet's
/// restaurant code or by the owner's one-time code. PIN login only works
/// from a linked device. Only a hash of the device token is stored.
model LinkedDevice {
  id                String    @id @default(uuid())
  organizationId    String
  /// Set when linked with an outlet's restaurant code; empty for an owner's device.
  outletId          String?
  tokenHash         String    @unique
  name              String?
  failedPinAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  lastUsedAt        DateTime  @default(now())
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  outlet       Outlet?      @relation(fields: [outletId], references: [id])
  sessions     Session[]

  @@index([organizationId])
  @@index([outletId])
}

model AuditLog {
  id             String   @id @default(uuid())
  actorId        String?
  action         String /// e.g. "job.approve"
  entity         String
  entityId       String?
  organizationId String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([entity, entityId])
  @@index([organizationId, createdAt])
}
